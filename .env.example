# Cloudflare Account & D1 Database Credentials
# (Leave blank for local offline mode; fill in for cloud multi-user synchronization)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

# Cloudflare R2 Object Storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=instagram-mockups
R2_PUBLIC_URL=https://preview.yourdomain.com

# Team Member Identifier (Optional, defaults to your OS username)
TEAM_MEMBER_NAME=
